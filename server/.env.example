PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/todo-app
# Frontend URL allowed by CORS (use * for any)
CLIENT_URL=*
# React app address, for the OAuth consent page ("Connect" in Claude). Falls back to CLIENT_URL.
APP_URL=http://localhost:5173
# Optional: more trusted OAuth redirect hosts, comma-separated (claude.ai, claude.com, localhost are always allowed)
OAUTH_REDIRECT_HOSTS=
# Secret used to sign login tokens (JWT). Use a long random string, keep it private.
JWT_SECRET=change-me-to-a-long-random-string
# How long a login lasts
JWT_EXPIRES_IN=7d
# Demo account made on every server start (only ONE per database).
# The Sign In screen fills it in. Set TEST_USER_ENABLED=false to turn it off (for example in production).
TEST_USER_ENABLED=true
TEST_USER_NAME=Test User
TEST_USER_EMAIL=test@todo.app
TEST_USER_PASSWORD=Test@1234
